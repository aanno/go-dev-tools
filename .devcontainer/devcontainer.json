// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
  "name": "go-dev-tools",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  // https://hub.docker.com/r/microsoft/devcontainers-go
  "image": "mcr.microsoft.com/devcontainers/go:1",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "latest"
    }
  },
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "java -version",
  // Configure tool-specific properties.
  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ"
    }
  },
  // no effect in idea
  "runArgs": [
    "--name=go-dev-tools",
    "--tmpfs=/tmp:exec",
    "--userns=keep-id:uid=${localEnv:CONTAINER_USERID},gid=${localEnv:CONTAINER_GROUPID}",
    "--cpus=2",
    "--memory=6g",
    "--shm-size=1g",
    // "--volume=tmp/.X11-unix:/tmp/.X11-unix:z,ro"
    // this is how to connect to external docker network
    // https://github.com/microsoft/vscode-remote-release/issues/4272
    "--network=go-dev-tools"
  ],
  // this seems to work
  "mounts": [
    // There seems to be no way to access the sources from the .devcontainer/devcontainer.json project
    // "source=/home/tpasch/scm/unmanaged/agraweb-backend-develop,target=/workspaces/java,type=bind,z,consistency=cached",
    // "source=${localEnv:GRADLE_USER_HOME},target=/home/vscode/.gradle,type=bind,z,consistency=cached",
    // "source=${localEnv:MVN_LOCAL_REPO},target=/home/vscode/.m2/repository,type=bind,z,consistency=cached",
    // "source=tmp,target=/tmp,type=bind,consistency=cached"
    "source=${localEnv:HOME}/go,target=/home/vscode/go,type=bind,z,consistency=cached",
    "type=tmpfs,destination=/tmp,tmpfs-mode=1777"
  ],
  "containerEnv": {
    // "REMOTE_DEV_JDK_DETECTION": "false",
    // "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current/bin/java",
  },
  "workspaceFolder": "/workspaces/go",
  // There seems to be no way to access the sources from the .devcontainer/devcontainer.json project
  // "workspaceMount": "source=/home/tpasch/it.nrw/gaeko-containers/gaeko-mirror,target=/workspaces/java,type=bind,z,consistency=cached",
  "workspaceMount": "source=.,target=/workspaces/go,type=bind,z,consistency=cached"
  // "postCreateCommand": "source /workspaces/java/podman/env.podman.local"
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
